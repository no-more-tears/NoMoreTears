{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "MaxRequests": 300,
    "WindowSizeInSeconds": 60
  },
  "Throttle": {
    "RequestsPerSecond": 10,
    "BurstSeconds": 3.0
  },
  "TrafficControl": {
    "KnownProxies": []
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [ "en", "uk" ]
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },
  "Identity": {
    "Jwt": {
      "Issuer": "nomoretears",
      "Audience": "nomoretears-api"
    },
    "Links": {
      "EmailConfirmationUrl": "https://nomoretears.example/confirm-email?userId={userId}&token={token}",
      "PasswordResetUrl": "https://nomoretears.example/reset-password?userId={userId}&token={token}"
    }
  },
  "Notification": {
    "InApp": {
      "Culture": "uk"
    }
  },
  "Masters": {
    "Storage": {
      "StagingBucket": "masters-staging",
      "DocumentsBucket": "masters-documents",
      "AvatarsBucket": "masters-avatars"
    }
  },
  "RabbitMqSettings": {
    "Port": 5672,
    "VirtualHost": "/"
  },
  "FileStorageSettings": {
    "UseSsl": false
  }
}