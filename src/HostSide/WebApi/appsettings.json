{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "MaxRequests": 300,
    "WindowSizeInSeconds": 60
  },
  "Throttle": {
    "RequestsPerSecond": 10,
    "BurstSeconds": 3.0
  },
  "TrafficControl": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },
  "Identity": {
    "Jwt": {
      "Issuer": "nomoretears",
      "Audience": "nomoretears-api"
    },
    "Links": {
      "EmailConfirmationUrl": "https://nomoretears.example/confirm-email?userId={userId}&token={token}",
      "PasswordResetUrl": "https://nomoretears.example/reset-password?userId={userId}&token={token}"
    }
  },
  "Notification": {
    "Smtp": {
      "Port": 587,
      "Security": "StartTls",
      "SenderName": "NoMoreTears"
    }
  }
}