{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ServiceName}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:80"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "ServiceName": "WebApiDocker"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "RedisCache": {
    "ConnectionString": "redis:6379",
    "InstanceName": "nomoretears"
  },
  "Identity": {
    "Links": {
      "EmailConfirmationUrl": "http://localhost:5173/confirm-email?userId={userId}&token={token}",
      "PasswordResetUrl": "http://localhost:5173/reset-password?userId={userId}&token={token}"
    }
  },
  "Notification": {
    "Smtp": {
      "Host": "papercut",
      "Port": 2525,
      "Security": "None",
      "SenderAddress": "no-reply@nomoretears.local"
    }
  }
}
