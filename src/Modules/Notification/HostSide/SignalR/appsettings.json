{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "Jwt": {
      "Issuer": "nomoretears",
      "Audience": "nomoretears-api"
    }
  },
  "SignalR": {
    "ChannelPrefix": "nomoretears",
    "HubsPathPrefix": "/hubs",
    "KeepAliveInterval": "00:00:15",
    "ClientTimeoutInterval": "00:00:30"
  },
  "RabbitMqSettings": {
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Notification": {
    "InApp": {
      "Culture": "uk",
      "UndeliveredBatchSize": 100
    },
    "Smtp": {
      "Port": 587,
      "Security": "StartTls",
      "SenderName": "NoMoreTears"
    }
  }
}
