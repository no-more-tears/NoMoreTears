<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates ship inside the assembly: Templates/Emails/{Template}/subject.txt, body.html, body.txt. -->
    <EmbeddedResource Include="Templates\Emails\**\*.txt;Templates\Emails\**\*.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Overrides the vulnerable 10.0.0 version referenced by MimeKit (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Shared\Common\Exceptions\NoMoreTears.Shared.Common.Exceptions.csproj" />
    <ProjectReference Include="..\..\Contracts\NoMoreTears.Modules.Notification.Contracts.csproj" />
  </ItemGroup>

</Project>
