# Template for infrastructure/docker/.env
# Generate a real .env with random credentials: infrastructure/scripts/generate-env.sh
# Or copy this file to .env and fill in the values manually.

# Shared
IMAGE_TAG=local

# Postgres
POSTGRES_DB=nomoretears
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@noreply.com
PGADMIN_DEFAULT_PASSWORD=changeme

# Redis
REDIS_PASSWORD=changeme

# Seq
SEQ_ADMIN_PASSWORD=changeme

# WebApi (JWT signing key must be at least 32 characters)
JWT_SIGNING_KEY=changeme-changeme-changeme-changeme-changeme